<!DOCTYPE html>
<html>
<head>

<style>

table{
border-collapse:collapse;
}

table,th,td{
border:1px solid black;
padding:10px;
text-align:center;
}

tr:nth-child(even){
background:lightgray;
}

</style>

</head>

<body>

<table>

<tr>
<th>Name</th>
<th>Event</th>
</tr>

<tr>
<td>Ali</td>
<td>Music</td>
</tr>

<tr>
<td>Sara</td>
<td>Sports</td>
</tr>

</table>

</body>
</html>
