import java.sql.*;

class JDBCExample
{
    public static void main(String[] args)
    {
        try
        {
            Connection con = DriverManager.getConnection(
                "jdbc:mysql://localhost:3306/test",
                "root",
                "password"
            );

            System.out.println("Database connected successfully");

            con.close();
        }
        catch(Exception e)
        {
            System.out.println(e);
        }
    }
}
