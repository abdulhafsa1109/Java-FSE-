fetch("https://jsonplaceholder.typicode.com/posts",{

method:"POST",

body:JSON.stringify({
name:"Ali"
}),

headers:{
"Content-Type":"application/json"
}

})

.then(response=>response.json())

.then(data=>console.log("Success"))

.catch(error=>console.log("Failed"));

setTimeout(function(){

console.log("Response Received");

},2000);
