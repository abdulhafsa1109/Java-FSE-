class Car
{
    String make;
    String model;
    int year;

    void displayDetails()
    {
        System.out.println(make);
        System.out.println(model);
        System.out.println(year);
    }

    public static void main(String[] args)
    {
        Car c = new Car();

        c.make = "Toyota";
        c.model = "Camry";
        c.year = 2025;

        c.displayDetails();
    }
}
